# R1 (presenter) profile — copy to .env in this profile's working directory
# (e.g. ~/realtimevoice-r1/.env) and fill in the values below.
# See DEPLOYMENT.md for the full setup procedure.

# Google AI Studio API key with access to the Gemini Live API. Required.
GEMINI_API_KEY=

# Which profile this process runs. The systemd unit (deploy/realtimevoice-r1.service)
# already pins this via Environment=ROBOT_PROFILE=r1, which takes priority
# over this file — but set it here too for anyone running the process
# directly (uv run uvicorn ...) without the systemd unit.
ROBOT_PROFILE=r1

# --- R1-specific: video-wall control agent -----------------------------
# Where the wall-agent (running on the video wall's own PC, next to
# Factories.exe — see README.md's "Видеостена") listens for commands.
WALL_AGENT_URL=http://<wall-pc-ip>:8093
# Only if the wall-agent itself requires a shared secret (X-Wall-Token) —
# leave empty if it doesn't.
# WALL_AGENT_TOKEN=

# --- Real robot hardware (audio in/out via the robot's own mic/speaker) --
# AUDIO_INPUT: "browser" (default) routes audio through whichever browser
# tab is connected, no hardware mic touched at all; "robot" or "usb" turn on
# hardware-input mode — this ONLY picks the starting preference for a fresh
# process, though: with USB_MIC_ALSA_DEVICE also set below, BOTH the
# built-in mic (via unitree_sdk2py — see README.md's "Запуск на роботе" for
# the CycloneDDS setup this requires) and the USB mic get made available
# together, and which one actually listens for the wake word is then chosen
# LIVE from the website (не .env, без перезапуска — 2026-09-06 ask) — see
# README.md's "Внешний USB-микрофон". Exactly one is ever listening at a
# time, never both at once.
AUDIO_INPUT=robot
# AUDIO_OUTPUT is a separate, independent choice (browser/robot/usb) — see
# README.md for why input and output aren't required to match (e.g. a USB
# mic for input with the robot's own built-in speaker for output).
AUDIO_OUTPUT=robot

# ALSA device for the USB mic above — takes effect whenever AUDIO_INPUT is
# "robot" or "usb" (not only when it's specifically "usb" — see the note
# above). Find the ALSA card ID with `arecord -l`/`aplay -l` or
# `cat /proc/asound/cards` (e.g. a Jabra Speak2 shows up as card "MS" — use
# "hw:MS,0", not the numeric card index, which can shift). Leave empty to
# not offer a USB mic choice at all. USB_SPEAKER_ALSA_DEVICE (for
# AUDIO_OUTPUT=usb, a separate choice) defaults to the same device if left
# unset.
# USB_MIC_ALSA_DEVICE=hw:MS,0
# USB_SPEAKER_ALSA_DEVICE=hw:MS,0
# USB_SPEAKER_VOLUME=100
# Rate the USB speaker is told to expect — NOT necessarily Gemini's real
# 24000Hz output (that's always resampled to this first). Measured live on
# a Jabra Speak2 40 MS (2026-09-06): declaring 24000 played ~30% too fast
# and noticeably higher-pitched ("голос будто слишком быстрый и высокий"),
# while 32000 came back accurate to the wall clock. 32000 is the default;
# override only if a DIFFERENT USB speaker model needs a different one —
# see README.md's "Внешний USB-микрофон" for how to measure it.
# USB_SPEAKER_SAMPLE_RATE=32000

# --- Wake word (item 5 of the 2026-09-04 fixes list) ----------------------
# On by default whenever AUDIO_INPUT is "robot" or "usb" — the mic stays
# always listening LOCALLY (nothing leaves the robot) for the wake phrase,
# and only forwards to Gemini for
# WAKE_ACTIVE_WINDOW_S after a hit (or the last robot turn, whichever is
# later). Runs a small faster-whisper model (real ASR, works in Russian out
# of the box — see app/wake_word.py) on ~WAKE_WORD_WINDOW_S-second buffered
# windows and checks the transcript for ANY of WAKE_WORD_PHRASES (comma-
# separated — item 2 of the 2026-09-06 UX list: more than one natural
# trigger word raises the odds a visitor who never read a sign near the
# robot happens to say something that works).
# Expanded again the same day so a visitor can wake the robot WITHOUT ever
# being told a magic word: plain greetings and a generic request for help,
# on top of the original robot/assistant-style words. The default list also
# includes G1's visit-intake trigger words (посетитель/визит/оформите/
# зарегистрируйте) — harmless no-ops here on R1, kept only so one shared
# default works sensibly for both profiles; trim them out if you'd rather
# keep this file's list presenter-only. Trade-off: "здравствуйте"/"привет"
# are common enough that busy foot traffic will trigger a false wake
# sometimes (45s of forwarded audio, not necessarily a spoken
# interruption) — trim this list if that becomes a real nuisance on site.
# WAKE_WORD_ENABLED=true
# WAKE_WORD_PHRASES=робот,ассистент,помощник,слушай,здравствуйте,привет,подскажите,посетитель,визит,оформите,зарегистрируйте
# WAKE_WORD_LANGUAGE=ru
# WAKE_WORD_WHISPER_MODEL=tiny
# WAKE_WORD_WINDOW_S=1.5
# WAKE_ACTIVE_WINDOW_S=45.0

# --- Presence detection (camera-based visitor greeting, R1 ТЗ §4.1) -----
# Off by default. See README.md's "Камера и реакция на посетителя" for the
# caveat about this camera's field of view before relying on it.
# PRESENCE_ENABLED=true
# Runs motion scoring in its own OS process (python -m app.presence_worker),
# isolated from the voice pipeline (2026-09-06 UX ask) — leave as "process"
# unless you have a specific reason to keep it in-process ("thread", the old
# behaviour).
# PRESENCE_ISOLATION=process

# --- Optional overrides — see README.md for when you'd need these --------
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Puck
# MAX_SESSION_DURATION_S=90

# --- Context window compression (2026-09-06) -----------------------------
# Gemini Live's OWN native answer to long sessions: once context passes
# CONTEXT_WINDOW_COMPRESSION_TRIGGER_TOKENS, Gemini compresses/summarizes
# older turns internally instead of eventually forcing a hard 1008 close —
# complements MAX_SESSION_DURATION_S above (which deliberately throws away
# ALL conversational memory on each proactive swap), it doesn't replace it.
# On by default. Leave the trigger/target tokens empty (default) unless
# logs show compression firing too late or too often for real usage.
# CONTEXT_WINDOW_COMPRESSION_ENABLED=true
# CONTEXT_WINDOW_COMPRESSION_TRIGGER_TOKENS=
# CONTEXT_WINDOW_COMPRESSION_TARGET_TOKENS=
