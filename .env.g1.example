# G1 (security-desk) profile — copy to .env in this profile's working
# directory (e.g. ~/realtimevoice-g1/.env) and fill in the values below.
# See DEPLOYMENT.md for the full setup procedure.

# Google AI Studio API key with access to the Gemini Live API. Required.
GEMINI_API_KEY=

# Which profile this process runs. The systemd unit (deploy/realtimevoice-g1.service)
# already pins this via Environment=ROBOT_PROFILE=g1, which takes priority
# over this file — but set it here too for anyone running the process
# directly (uv run uvicorn ...) without the systemd unit.
ROBOT_PROFILE=g1

# --- Real robot hardware (audio in/out) ----------------------------------
# "browser" routes audio through whichever browser tab is connected;
# "robot" uses the built-in head-mic/DDS speaker via unitree_sdk2py (see
# README.md's "Запуск на роботе" for the CycloneDDS setup this requires);
# "usb" uses an external USB mic/speaker (e.g. a Jabra Speak2 — item 6 of
# the 2026-09-04 fixes list) via plain ALSA, see USB_*_ALSA_DEVICE below —
# no CycloneDDS/vendor SDK needed for this path. AUDIO_INPUT here only picks
# the STARTING preference for a fresh process: with USB_MIC_ALSA_DEVICE also
# set, both the built-in mic and the USB mic get made available together,
# and which one actually listens for the wake word is chosen LIVE from the
# website afterward (не .env, без перезапуска — 2026-09-06 ask) — see
# README.md's "Внешний USB-микрофон". Exactly one listens at a time, never
# both at once.
AUDIO_INPUT=usb
AUDIO_OUTPUT=usb

# ALSA card ID for AUDIO_INPUT/OUTPUT=usb — find it with `arecord -l`/
# `aplay -l` or `cat /proc/asound/cards` (e.g. a Jabra Speak2 shows up as
# card "MS" — use "hw:MS,0", not the numeric card index, which can shift).
# USB_SPEAKER_ALSA_DEVICE defaults to this same value if left unset — the
# common case is one device serving as both mic and speaker.
USB_MIC_ALSA_DEVICE=hw:MS,0
# USB_SPEAKER_ALSA_DEVICE=hw:MS,0
# USB_SPEAKER_VOLUME=100
# Rate the USB speaker is told to expect — NOT necessarily Gemini's real
# 24000Hz output (that's always resampled to this first). Measured live on
# a Jabra Speak2 40 MS (2026-09-06): declaring 24000 played ~30% too fast
# and noticeably higher-pitched, while 32000 came back accurate to the wall
# clock. 32000 is the default; override only if a DIFFERENT USB speaker
# model needs a different one — see README.md's "Внешний USB-микрофон" for
# how to measure it.
# USB_SPEAKER_SAMPLE_RATE=32000

# --- Wake word (item 5 of the 2026-09-04 fixes list) ----------------------
# On by default whenever a hardware mic is configured above — the mic stays
# always listening LOCALLY (nothing leaves the robot) for the wake phrase,
# and only forwards to Gemini for WAKE_ACTIVE_WINDOW_S after a hit (or the
# last robot turn, whichever is later). Runs a small faster-whisper model
# (real ASR, works in Russian out of the box — see app/wake_word.py) on
# ~WAKE_WORD_WINDOW_S-second buffered windows and checks the transcript for
# ANY of WAKE_WORD_PHRASES (comma-separated — item 2 of the 2026-09-06 UX
# list: more than one natural trigger word raises the odds a visitor who
# never read a sign near the robot happens to say something that works).
# Expanded again the same day so a visitor can wake the robot WITHOUT ever
# being told a magic word: plain greetings, a generic request for help, and
# (for G1) the exact phrases the robot is already listening for to start a
# visit registration ("оформите визит" etc. — see app/scenarios.py) so
# saying that cold actually wakes the mic instead of going unheard. Trade-
# off: "здравствуйте"/"привет" are common enough that busy foot traffic
# will trigger a false wake sometimes (45s of forwarded audio, not
# necessarily a spoken interruption) — trim this list if that becomes a
# real nuisance on site.
# WAKE_WORD_ENABLED=true
# WAKE_WORD_PHRASES=робот,ассистент,помощник,слушай,здравствуйте,привет,подскажите,посетитель,визит,оформите,зарегистрируйте
# WAKE_WORD_LANGUAGE=ru
# WAKE_WORD_WHISPER_MODEL=tiny
# WAKE_WORD_WINDOW_S=1.5
# WAKE_ACTIVE_WINDOW_S=45.0

# --- Presence detection (camera-based visitor greeting, G1 ТЗ §3.1) -----
# Off by default. See README.md's "Камера и реакция на посетителя" for the
# caveat about this camera's field of view before relying on it.
# PRESENCE_ENABLED=true
# Runs motion scoring in its own OS process (python -m app.presence_worker),
# isolated from the voice pipeline (2026-09-06 UX ask) — leave as "process"
# unless you have a specific reason to keep it in-process ("thread", the old
# behaviour).
# PRESENCE_ISOLATION=process

# --- Knowledge base (config/guard-kb.yaml + knowledge_guard/*.md) --------
# Both ship with example content — replace with the customer's actual room
# directory / FAQ / venue info before going into production (see
# DEPLOYMENT.md). GUARD_KB_PATH lets you point at a different file instead
# of editing config/guard-kb.yaml in place.
# GUARD_KB_PATH=config/guard-kb.yaml

# --- Optional overrides — see README.md for when you'd need these --------
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Charon
# MAX_SESSION_DURATION_S=90

# --- Context window compression (2026-09-06) -----------------------------
# Gemini Live's OWN native answer to long sessions: once context passes
# CONTEXT_WINDOW_COMPRESSION_TRIGGER_TOKENS, Gemini compresses/summarizes
# older turns internally instead of eventually forcing a hard 1008 close —
# complements MAX_SESSION_DURATION_S above (which deliberately throws away
# ALL conversational memory on each proactive swap), it doesn't replace it.
# On by default. Leave the trigger/target tokens empty (default) unless
# logs show compression firing too late or too often for real usage.
# CONTEXT_WINDOW_COMPRESSION_ENABLED=true
# CONTEXT_WINDOW_COMPRESSION_TRIGGER_TOKENS=
# CONTEXT_WINDOW_COMPRESSION_TARGET_TOKENS=
