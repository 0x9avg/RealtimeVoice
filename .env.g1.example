# G1 (security-desk) profile — copy to .env in this profile's working
# directory (e.g. ~/realtimevoice-g1/.env) and fill in the values below.
# See DEPLOYMENT.md for the full setup procedure.

# Google AI Studio API key with access to the Gemini Live API. Required.
GEMINI_API_KEY=

# Which profile this process runs. The systemd unit (deploy/realtimevoice-g1.service)
# already pins this via Environment=ROBOT_PROFILE=g1, which takes priority
# over this file — but set it here too for anyone running the process
# directly (uv run uvicorn ...) without the systemd unit.
ROBOT_PROFILE=g1

# --- Real robot hardware (audio in/out via the robot's own mic/speaker) --
# "browser" (default) routes audio through whichever browser tab is
# connected; "robot" uses the physical hardware via unitree_sdk2py — see
# README.md's "Запуск на роботе" for the CycloneDDS setup this requires.
AUDIO_INPUT=robot
AUDIO_OUTPUT=robot

# --- Presence detection (camera-based visitor greeting, G1 ТЗ §3.1) -----
# Off by default. See README.md's "Камера и реакция на посетителя" for the
# caveat about this camera's field of view before relying on it.
# PRESENCE_ENABLED=true

# --- Knowledge base (config/guard-kb.yaml + knowledge_guard/*.md) --------
# Both ship with example content — replace with the customer's actual room
# directory / FAQ / venue info before going into production (see
# DEPLOYMENT.md). GUARD_KB_PATH lets you point at a different file instead
# of editing config/guard-kb.yaml in place.
# GUARD_KB_PATH=config/guard-kb.yaml

# --- Access control -------------------------------------------------------
# Bearer token gating the operator web UI (/guard admin actions, /api/*).
# Empty (default) disables the check — set a real value for any deployment
# reachable by more than trusted staff. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_TOKEN=

# --- Optional overrides — see README.md for when you'd need these --------
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Fenrir
# MAX_SESSION_DURATION_S=360
