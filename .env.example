# Google AI Studio API key with access to the Gemini Live API.
GEMINI_API_KEY=

# Which robot this process is today — "r1" (presenter, default) or "g1"
# (security-desk guard). Fixed at process start (Settings is a singleton
# read once at import); switch profiles by changing this and restarting.
# ROBOT_PROFILE=r1

# Optional overrides — see README for why you might need to change these.
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Fenrir
